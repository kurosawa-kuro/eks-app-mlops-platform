PORT=38002
NODE_ENV=development
JWT_SECRET=your-jwt-secret-change-me-32chars-min!

# Token TTL (seconds)
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=604800

# Cognito configuration (required for production)
# COGNITO_USER_POOL_ID=ap-northeast-1_xxxxx
# COGNITO_CLIENT_ID=xxxxxxxxx
# COGNITO_REGION=ap-northeast-1

# Redis (optional, for distributed blacklist)
# REDIS_URL=redis://localhost:6379
