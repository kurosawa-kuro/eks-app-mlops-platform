# =============================================================================
# Hono App Environment Variables
# =============================================================================

# Server
PORT=8000
NODE_ENV=development

# =============================================================================
# Database (PostgreSQL - Neon or Local)
# =============================================================================
# Neon (Cloud):
# DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/appdb?sslmode=require"
# Local Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appdb?schema=public"
DATABASE_URL=

# =============================================================================
# Authentication
# =============================================================================
# JWT secret (minimum 32 characters, required in production)
JWT_SECRET=your-jwt-secret-change-me-32chars-min!
# Token expiry in seconds (default: 3600 = 1 hour)
JWT_EXPIRY_SECONDS=3600
# Access token TTL in seconds (default: 900 = 15 minutes)
ACCESS_TOKEN_TTL=900
# Refresh token TTL in seconds (default: 604800 = 7 days)
REFRESH_TOKEN_TTL=604800

# External auth service URL (optional - for delegating token verification)
# AUTH_SERVICE_URL=https://your-auth-gateway.example.com

# =============================================================================
# Cognito (for token verification)
# =============================================================================
# COGNITO_USER_POOL_ID=ap-northeast-1_xxxxx
# COGNITO_CLIENT_ID=xxxxxxxxx
# COGNITO_REGION=ap-northeast-1

# =============================================================================
# CORS / CSRF
# =============================================================================
# Allowed origin for CORS/CSRF (comma-separated for multiple)
# ALLOWED_ORIGIN=http://localhost:3000

# =============================================================================
# Storage (for production, use Redis)
# =============================================================================
# Token blacklist storage: memory | redis
TOKEN_BLACKLIST_STORE=memory
# Rate limit storage: memory | redis
RATE_LIMIT_STORE=memory
# Redis URL (required if using redis storage)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Logging
# =============================================================================
# Log mode: console | firehose
LOG_MODE=console
# Firehose settings (only used when LOG_MODE=firehose)
FIREHOSE_STREAM_NAME=app-log-stream
AWS_REGION=ap-northeast-1
# Error logging to CloudWatch Logs (optional)
# ERROR_LOG_GROUP=/hono-app/errors

# =============================================================================
# Analytics (staging only)
# =============================================================================
ENABLE_ANALYTICS_API=false
# ANALYTICS_S3_BUCKET=my-analytics-bucket

# =============================================================================
# LLM Proxy (internal)
# =============================================================================
ENABLE_LLM_API=false
# LLM_INFERENCE_URL=http://localhost:8080/inference
# LLM_EMBEDDINGS_URL=http://localhost:8080/embeddings
