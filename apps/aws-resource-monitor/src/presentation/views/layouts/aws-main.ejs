<!DOCTYPE html>
<html lang="ja" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <style>
    /* =========================================
       Pico.css – Dashboard Dark Theme
       Mosaic-inspired Layout
       ========================================= */
    :root {
      --pico-font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }

    :root[data-theme="dark"] {
      /* 背景 */
      --pico-background-color: #111827;
      --pico-background-color-rgb: 17, 24, 39;

      /* サーフェス（カード・サイドバー） */
      --pico-card-background-color: #1f2937;
      --pico-card-sectioning-background-color: #1f2937;

      /* ボーダー */
      --pico-border-color: #374151;
      --pico-muted-border-color: #374151;

      /* テキスト */
      --pico-color: #e5e7eb;
      --pico-muted-color: #9ca3af;
      --pico-h1-color: #f9fafb;
      --pico-h2-color: #f3f4f6;
      --pico-h3-color: #e5e7eb;

      /* アクセント（Violet/Indigo） */
      --pico-primary: #8b5cf6;
      --pico-primary-hover: #a78bfa;
      --pico-primary-focus: rgba(139, 92, 246, 0.25);
      --pico-primary-inverse: #ffffff;

      /* フォーム */
      --pico-form-element-background-color: #111827;
      --pico-form-element-border-color: #374151;
      --pico-form-element-color: #e5e7eb;
      --pico-form-element-placeholder-color: #6b7280;
      --pico-form-element-active-border-color: #8b5cf6;

      /* ボタン */
      --pico-button-background-color: #8b5cf6;
      --pico-button-hover-background-color: #a78bfa;
      --pico-button-color: #ffffff;

      /* コード・ログ表示 */
      --pico-code-background-color: #0f172a;
      --pico-code-color: #e5e7eb;

      /* 状態色 */
      --pico-success: #10b981;
      --pico-warning: #f59e0b;
      --pico-danger: #ef4444;
      --pico-info: #3b82f6;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      overflow: hidden;
    }

    /* =========================================
       Layout Structure
       ========================================= */
    .app-wrapper {
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* Sidebar */
    .sidebar {
      width: 256px;
      background: var(--pico-card-background-color);
      border-right: 1px solid var(--pico-muted-border-color);
      display: flex;
      flex-direction: column;
      transition: width 0.2s ease, transform 0.2s ease;
      flex-shrink: 0;
      overflow-y: auto;
      overflow-x: hidden;
      z-index: 100;
    }

    .sidebar.collapsed {
      width: 72px;
    }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem;
      border-bottom: 1px solid var(--pico-muted-border-color);
      min-height: 64px;
    }

    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--pico-h1-color);
      font-weight: 600;
      font-size: 1.1rem;
    }

    .sidebar-logo svg {
      width: 32px;
      height: 32px;
      fill: var(--pico-primary);
      flex-shrink: 0;
    }

    .sidebar-logo span {
      white-space: nowrap;
      transition: opacity 0.2s ease;
    }

    .sidebar.collapsed .sidebar-logo span {
      opacity: 0;
      width: 0;
      overflow: hidden;
    }

    .sidebar-nav {
      flex: 1;
      padding: 1rem 0.75rem;
    }

    .nav-section {
      margin-bottom: 1.5rem;
    }

    .nav-section-title {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--pico-muted-color);
      padding: 0 0.75rem;
      margin-bottom: 0.5rem;
      white-space: nowrap;
      transition: opacity 0.2s ease;
    }

    .sidebar.collapsed .nav-section-title {
      opacity: 0;
      height: 0;
      margin: 0;
      overflow: hidden;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.75rem;
      border-radius: 0.5rem;
      color: var(--pico-color);
      text-decoration: none;
      font-size: 0.875rem;
      transition: all 0.15s ease;
      margin-bottom: 0.25rem;
      white-space: nowrap;
    }

    .nav-item:hover {
      background: rgba(139, 92, 246, 0.1);
      color: var(--pico-h1-color);
    }

    .nav-item.active {
      background: linear-gradient(to right, rgba(139, 92, 246, 0.15), rgba(139, 92, 246, 0.05));
      color: var(--pico-primary);
    }

    .nav-item svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
      flex-shrink: 0;
      opacity: 0.7;
    }

    .nav-item.active svg {
      opacity: 1;
    }

    .nav-item span {
      transition: opacity 0.2s ease;
    }

    .sidebar.collapsed .nav-item span {
      opacity: 0;
      width: 0;
      overflow: hidden;
    }

    .sidebar-footer {
      padding: 1rem;
      border-top: 1px solid var(--pico-muted-border-color);
    }

    .sidebar-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 0.5rem;
      background: transparent;
      border: 1px solid var(--pico-muted-border-color);
      border-radius: 0.5rem;
      color: var(--pico-muted-color);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .sidebar-toggle:hover {
      background: rgba(139, 92, 246, 0.1);
      color: var(--pico-color);
    }

    .sidebar-toggle svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
      transition: transform 0.2s ease;
    }

    .sidebar.collapsed .sidebar-toggle svg {
      transform: rotate(180deg);
    }

    /* Main Content Area */
    .main-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-width: 0;
    }

    /* Header */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      height: 64px;
      background: var(--pico-card-background-color);
      border-bottom: 1px solid var(--pico-muted-border-color);
      flex-shrink: 0;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .mobile-menu-btn {
      display: none;
      padding: 0.5rem;
      background: transparent;
      border: none;
      color: var(--pico-muted-color);
      cursor: pointer;
      border-radius: 0.375rem;
    }

    .mobile-menu-btn:hover {
      background: rgba(139, 92, 246, 0.1);
      color: var(--pico-color);
    }

    .mobile-menu-btn svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    .header-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--pico-h1-color);
      margin: 0;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .header-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background: transparent;
      border: none;
      border-radius: 50%;
      color: var(--pico-muted-color);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .header-btn:hover {
      background: rgba(139, 92, 246, 0.1);
      color: var(--pico-color);
    }

    .header-btn svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--pico-primary), #6366f1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
    }

    /* Main Content */
    .main-content {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
      background: var(--pico-background-color);
    }

    .content-container {
      max-width: 1600px;
      margin: 0 auto;
    }

    /* Cards */
    article {
      background: var(--pico-card-background-color);
      border: 1px solid var(--pico-muted-border-color);
      border-radius: 0.75rem;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    /* List Items */
    .list-item {
      background: var(--pico-card-background-color);
      border: 1px solid var(--pico-muted-border-color);
      border-left: 3px solid transparent;
      border-radius: 0.5rem;
      padding: 0.875rem 1rem;
      margin-bottom: 0.5rem;
      transition: all 0.15s ease;
    }

    .list-item:last-child {
      margin-bottom: 0;
    }

    .list-item:hover {
      border-left-color: var(--pico-primary);
    }

    .list-item-content {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .list-item-image {
      width: 48px;
      height: 48px;
      object-fit: cover;
      border-radius: 0.5rem;
      border: 1px solid var(--pico-muted-border-color);
      flex-shrink: 0;
    }

    .no-image {
      width: 48px;
      height: 48px;
      background: var(--pico-background-color);
      border-radius: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--pico-muted-color);
      font-size: 0.65rem;
      flex-shrink: 0;
    }

    .list-item-info {
      flex: 1;
      min-width: 0;
    }

    .list-item .id {
      font-size: 0.7rem;
      color: var(--pico-muted-color);
      margin-bottom: 0.125rem;
      font-family: 'SF Mono', Monaco, Consolas, monospace;
    }

    .list-item .title {
      color: var(--pico-color);
      font-size: 0.9rem;
      font-weight: 500;
      word-break: break-word;
    }

    /* Empty State */
    .empty-state {
      padding: 2rem;
      text-align: center;
      color: var(--pico-muted-color);
    }

    /* Page Header */
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .page-title {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--pico-h1-color);
      margin: 0;
    }

    .page-subtitle {
      color: var(--pico-muted-color);
      font-size: 0.875rem;
      margin-top: 0.25rem;
    }

    /* Breadcrumb */
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      color: var(--pico-muted-color);
      margin-bottom: 1rem;
    }

    .breadcrumb a {
      color: var(--pico-muted-color);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--pico-primary);
    }

    .breadcrumb span {
      color: var(--pico-color);
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .stat-card {
      background: var(--pico-card-background-color);
      border: 1px solid var(--pico-muted-border-color);
      border-radius: 0.75rem;
      padding: 1.25rem;
    }

    .stat-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }

    .stat-card-title {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--pico-muted-color);
    }

    .stat-card-icon {
      width: 32px;
      height: 32px;
      border-radius: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .stat-card-icon svg {
      width: 16px;
      height: 16px;
    }

    .stat-card-icon.purple {
      background: rgba(139, 92, 246, 0.2);
      color: #a78bfa;
    }

    .stat-card-icon.blue {
      background: rgba(59, 130, 246, 0.2);
      color: #60a5fa;
    }

    .stat-card-icon.green {
      background: rgba(16, 185, 129, 0.2);
      color: #34d399;
    }

    .stat-card-icon.amber {
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
    }

    .stat-card-value {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--pico-h1-color);
      margin-bottom: 0.25rem;
    }

    .stat-card-change {
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .stat-card-change.positive {
      color: var(--pico-success);
    }

    .stat-card-change.negative {
      color: var(--pico-danger);
    }

    /* Form Styles */
    form label {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--pico-color);
    }

    input, select, textarea {
      font-size: 0.875rem;
    }

    button[type="submit"] {
      font-weight: 500;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        height: 100vh;
        transform: translateX(-100%);
        z-index: 1000;
      }

      .sidebar.open {
        transform: translateX(0);
      }

      .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 999;
      }

      .sidebar-overlay.active {
        display: block;
      }

      .mobile-menu-btn {
        display: flex;
      }

      .sidebar-toggle {
        display: none;
      }
    }

    @media (max-width: 640px) {
      .main-content {
        padding: 1rem;
      }

      .header {
        padding: 0 1rem;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }
    }

    /* =========================================
       Shared Component Styles
       ========================================= */

    /* Stats Bar (used in dashboard, eks-overview, alerts) */
    .stats-bar {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .stat-item {
      background: var(--pico-card-background-color);
      border: 1px solid var(--pico-muted-border-color);
      border-radius: 0.5rem;
      padding: 0.75rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .stat-item.danger {
      border-color: #ef4444;
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), transparent);
    }

    .stat-item.warning {
      border-color: #f97316;
      background: linear-gradient(135deg, rgba(249, 115, 22, 0.08), transparent);
    }

    .stat-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--pico-muted-color);
    }

    .stat-value {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--pico-h1-color);
    }

    .stat-value.highlight {
      color: var(--pico-primary);
    }

    .stat-value.danger {
      color: #ef4444;
    }

    .stat-value.warning {
      color: #f97316;
    }

    /* Status Indicators */
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .status-ok { background: var(--pico-success); }
    .status-pending { background: var(--pico-warning); }
    .status-warning { background: #f97316; }
    .status-error { background: var(--pico-danger); }
    .status-inactive { background: #6b7280; }

    /* Refresh Button */
    .refresh-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: var(--pico-primary);
      color: white;
      border: none;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      cursor: pointer;
      text-decoration: none;
    }

    .refresh-btn:hover {
      background: var(--pico-primary-hover);
    }

    /* Resource Cards */
    .resource-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .resource-card {
      background: var(--pico-card-background-color);
      border: 1px solid var(--pico-muted-border-color);
      border-radius: 0.75rem;
      padding: 1rem;
    }

    .resource-card.highlight {
      border-color: var(--pico-primary);
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), transparent);
    }

    .resource-card.cost-critical {
      border: 2px solid #ef4444;
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), transparent);
    }

    .resource-card.cost-warning {
      border: 2px solid #f97316;
      background: linear-gradient(135deg, rgba(249, 115, 22, 0.08), transparent);
    }

    .resource-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--pico-muted-border-color);
    }

    .resource-card-title {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--pico-h2-color);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .resource-card-count {
      font-size: 0.75rem;
      color: var(--pico-muted-color);
      background: var(--pico-background-color);
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
    }

    .resource-list {
      list-style: none;
      padding: 0;
      margin: 0;
      max-height: 300px;
      overflow-y: auto;
    }

    .resource-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.375rem 0;
      font-size: 0.8rem;
    }

    .resource-item + .resource-item {
      border-top: 1px solid var(--pico-muted-border-color);
    }

    .resource-name {
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--pico-color);
    }

    .resource-state {
      font-size: 0.7rem;
      color: var(--pico-muted-color);
      text-transform: lowercase;
    }

    .resource-id {
      font-size: 0.65rem;
      color: var(--pico-muted-color);
      font-family: 'SF Mono', Monaco, Consolas, monospace;
    }

    /* Cost Badge */
    .cost-badge {
      font-size: 0.65rem;
      padding: 0.15rem 0.4rem;
      border-radius: 0.25rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .cost-badge.critical {
      background: #ef4444;
      color: white;
    }

    .cost-badge.warning {
      background: #f97316;
      color: white;
    }

    /* Section Header */
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 1.5rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--pico-muted-border-color);
    }

    .section-title {
      font-size: 1rem;
      font-weight: 600;
      color: var(--pico-h2-color);
      margin: 0;
    }

    .section-count {
      font-size: 0.75rem;
      color: var(--pico-muted-color);
    }
  </style>
  <%- typeof head !== 'undefined' ? head : '' %>
</head>
<body>
  <div class="app-wrapper">
    <!-- Sidebar Overlay (Mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <a href="/" class="sidebar-logo">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
            <path d="M31.956 14.8C31.372 6.92 25.08.628 17.2.044V5.76a9.04 9.04 0 0 0 9.04 9.04h5.716ZM14.8 26.24v5.716C6.92 31.372.63 25.08.044 17.2H5.76a9.04 9.04 0 0 1 9.04 9.04Zm11.44-9.04h5.716c-.584 7.88-6.876 14.172-14.756 14.756V26.24a9.04 9.04 0 0 1 9.04-9.04ZM.044 14.8C.63 6.92 6.92.628 14.8.044V5.76a9.04 9.04 0 0 1-9.04 9.04H.044Z"/>
          </svg>
          <span>Top</span>
        </a>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-section">
          <div class="nav-section-title">Overview</div>
          <a href="/" class="nav-item<%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? ' active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
              <path d="M5.936.278A7.983 7.983 0 0 1 8 0a8 8 0 1 1-8 8c0-.722.104-1.413.278-2.064a1 1 0 1 1 1.932.516A5.99 5.99 0 0 0 2 8a6 6 0 1 0 6-6c-.53 0-1.045.076-1.548.21A1 1 0 1 1 5.936.278Z"/>
              <path d="M6.068 7.482A2.003 2.003 0 0 0 8 10a2 2 0 1 0-.518-3.932L3.707 2.293a1 1 0 0 0-1.414 1.414l3.775 3.775Z"/>
            </svg>
            <span>Dashboard</span>
          </a>
          <a href="/resources" class="nav-item<%= typeof activePage !== 'undefined' && activePage === 'resources' ? ' active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
