<style>
  /* K8s Dashboard Styles - Minimal Mode */
  .status-banner {
    padding: 1.5rem;
    border-radius: 0.75rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .status-banner.status-ok {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.15), transparent);
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .status-banner.status-ng {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), transparent);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .status-banner .status-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .status-banner .status-text {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .status-banner.status-ok .status-text {
    color: #22c55e;
  }

  .status-banner.status-ng .status-text {
    color: #ef4444;
  }

  .namespace-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .namespace-card {
    background: var(--pico-card-background-color);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: 0.75rem;
    padding: 1rem;
  }

  .namespace-card.all-running {
    border-left: 3px solid #22c55e;
  }

  .namespace-card.has-issues {
    border-left: 3px solid #ef4444;
  }

  .namespace-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--pico-muted-border-color);
  }

  .namespace-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--pico-h2-color);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .namespace-status {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }

  .namespace-status.running {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  .namespace-status.issues {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  .pod-list {
    max-height: 250px;
    overflow-y: auto;
  }

  .pod-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--pico-muted-border-color);
  }

  .pod-item:last-child {
    border-bottom: none;
  }

  .pod-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--pico-color);
    font-family: monospace;
  }

  .pod-phase {
    font-size: 0.7rem;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-weight: 500;
  }

  .pod-phase.running {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  .pod-phase.notrunning {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  .last-updated {
    text-align: center;
    font-size: 0.75rem;
    color: var(--pico-muted-color);
    margin-top: 1rem;
  }

  .empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--pico-muted-color);
  }

  .empty-state-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .k8s-disabled-notice {
    background: linear-gradient(135deg, rgba(234, 179, 8, 0.1), transparent);
    border: 1px solid #f59e0b;
    border-radius: 0.75rem;
    padding: 2rem;
    text-align: center;
  }

  .k8s-disabled-notice h3 {
    color: #f59e0b;
    margin-bottom: 0.5rem;
  }

  .k8s-disabled-notice p {
    color: var(--pico-muted-color);
    font-size: 0.875rem;
  }

  .k8s-disabled-notice code {
    background: var(--pico-background-color);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.8rem;
  }

  .error-banner {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), transparent);
    border: 1px solid #ef4444;
    border-radius: 0.75rem;
    padding: 1rem;
    margin-bottom: 1rem;
    color: #ef4444;
  }

  /* GPU/Karpenter/LLM Section Styles */
  .infra-section {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--pico-muted-border-color);
  }

  .infra-section h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .infra-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .infra-card {
    background: var(--pico-card-background-color);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: 0.75rem;
    padding: 1rem;
  }

  .infra-card.healthy {
    border-left: 3px solid #22c55e;
  }

  .infra-card.warning {
    border-left: 3px solid #f59e0b;
  }

  .infra-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .infra-card-title {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .infra-badge {
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    font-weight: 500;
  }

  .infra-badge.spot {
    background: rgba(168, 85, 247, 0.15);
    color: #a855f7;
  }

  .infra-badge.on-demand {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
  }

  .infra-badge.running {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  .infra-stat {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--pico-muted-border-color);
  }

  .infra-stat:last-child {
    border-bottom: none;
  }

  .infra-stat-label {
    color: var(--pico-muted-color);
  }

  .infra-stat-value {
    font-weight: 500;
    font-family: monospace;
  }

  .gpu-icon {
    color: #10b981;
  }

  .llm-icon {
    color: #8b5cf6;
  }

  .karpenter-icon {
    color: #f97316;
  }

  /* Ephemeral node indicator */
  .infra-card-ephemeral {
    font-size: 0.65rem;
    color: var(--pico-muted-color);
    opacity: 0.7;
    margin-top: 0.25rem;
  }

  /* Node age display (Karpenter orange) */
  .node-age {
    color: #f97316;
  }

  /* GPU dependency indicator */
  .gpu-dependency {
    font-size: 0.65rem;
    color: #10b981;
    opacity: 0.8;
    margin-top: 0.25rem;
  }

  /* Status banner subtext */
  .status-subtext {
    font-size: 0.85rem;
    opacity: 0.8;
    margin-top: 0.25rem;
  }

  /* Running pods should be dimmed (highlight issues only) */
  .pod-phase.running {
    opacity: 0.5;
  }
</style>

<!-- Breadcrumb -->
<nav class="breadcrumb">
  <a href="/">Dashboard</a>
  <span>/</span>
  <span>K8s Monitoring</span>
</nav>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h2 class="page-title">Kubernetes Monitoring</h2>
    <p class="page-subtitle">Pod Status (Minimal Mode)</p>
  </div>
  <% if (k8sEnabled) { %>
  <button class="refresh-btn" onclick="refreshK8s()">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
      <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
      <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
    </svg>
    Refresh
  </button>
  <% } %>
</div>

<% if (!k8sEnabled) { %>
<!-- K8s Disabled Notice -->
<div class="k8s-disabled-notice">
  <div style="font-size: 3rem; margin-bottom: 1rem;">&#9096;</div>
  <h3>Kubernetes Monitoring is Disabled</h3>
  <p>To enable K8s monitoring, set the following environment variable:</p>
  <p style="margin-top: 1rem;"><code>K8S_ENABLED=true</code></p>
</div>
<% } else if (typeof error !== 'undefined' && error) { %>
<!-- Error State -->
<div class="error-banner">
  <strong>Error:</strong> <%= error %>
</div>
<% } else if (status) { %>

<!-- Status Banner -->
<div class="status-banner status-<%= status.status.toLowerCase() %>">
  <div class="status-icon">
    <% if (status.status === 'OK') { %>&#10003;<% } else { %>&#10007;<% } %>
  </div>
  <div class="status-text">
    <%= status.status === 'OK' ? 'All Pods Running' : 'Some Pods Not Running' %>
    <% if (status.status === 'OK' && (status.gpuNodes?.totalNodes > 0 || status.llm?.allRunning)) { %>
    <div class="status-subtext">
      (<% if (status.gpuNodes?.totalNodes > 0) { %>GPU nodes: <%= status.gpuNodes.totalNodes %> active<% } %><% if (status.gpuNodes?.totalNodes > 0 && status.llm?.allRunning) { %>, <% } %><% if (status.llm?.allRunning) { %>LLM services: Running<% } %>)
    </div>
    <% } %>
  </div>
</div>

<!-- Namespace Grid -->
<div class="namespace-grid">
  <% status.namespaces.forEach(ns => { %>
  <div class="namespace-card <%= ns.error ? 'has-issues' : (ns.allRunning ? 'all-running' : 'has-issues') %>">
    <div class="namespace-header">
      <span class="namespace-name">
        <span>&#128230;</span>
        <%= ns.namespace %>
      </span>
      <span class="namespace-status <%= ns.error ? 'issues' : (ns.allRunning ? 'running' : 'issues') %>">
        <%= ns.error ? 'Error' : (ns.allRunning ? 'All Running' : 'Issues') %>
      </span>
    </div>
    <% if (ns.error) { %>
    <div class="empty-state" style="color: #ef4444;">
      <div class="empty-state-icon">&#9888;</div>
      <p>Connection Error</p>
      <p style="font-size: 0.75rem; margin-top: 0.5rem; word-break: break-all;"><%= ns.error %></p>
    </div>
    <% } else if (ns.pods.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">&#128230;</div>
      <p>No pods in this namespace</p>
    </div>
    <% } else { %>
    <div class="pod-list">
      <% ns.pods.forEach(pod => { %>
      <div class="pod-item">
        <span class="status-dot <%= pod.phase === 'Running' ? 'status-ok' : 'status-error' %>"></span>
        <span class="pod-name"><%= pod.name %></span>
        <span class="pod-phase <%= pod.phase.toLowerCase() %>"><%= pod.rawPhase %></span>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
  <% }); %>
</div>

<!-- Karpenter Section -->
<% if (status.karpenter) { %>
<div class="infra-section">
  <h3><span class="karpenter-icon">&#9881;</span> Karpenter</h3>
  <div class="infra-grid">
    <div class="infra-card <%= status.karpenter.running === status.karpenter.total ? 'healthy' : 'warning' %>">
      <div class="infra-card-header">
        <span class="infra-card-title">Controller Status</span>
        <span class="infra-badge running"><%= status.karpenter.running %>/<%= status.karpenter.total %> Running</span>
      </div>
      <div class="infra-stat">
        <span class="infra-stat-label">Running Pods</span>
        <span class="infra-stat-value"><%= status.karpenter.running %></span>
      </div>
      <div class="infra-stat">
        <span class="infra-stat-label">Total Pods</span>
        <span class="infra-stat-value"><%= status.karpenter.total %></span>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- GPU Nodes Section -->
<% if (status.gpuNodes && status.gpuNodes.totalNodes > 0) { %>
<div class="infra-section">
  <h3><span class="gpu-icon">&#128187;</span> GPU Nodes</h3>
  <div class="infra-grid">
    <% status.gpuNodes.nodes.forEach(node => { %>
    <div class="infra-card <%= node.ready ? 'healthy' : 'warning' %>">
      <div class="infra-card-header">
        <span class="infra-card-title"><%= node.instanceType %></span>
        <span class="infra-badge <%= node.capacityType %>"><%= node.capacityType.toUpperCase() %></span>
      </div>
      <div class="infra-card-ephemeral">Auto-provisioned by Karpenter</div>
      <div class="infra-stat">
        <span class="infra-stat-label">Node</span>
        <span class="infra-stat-value" style="font-size: 0.75rem;"><%= node.name.substring(0, 30) %>...</span>
      </div>
      <div class="infra-stat">
        <span class="infra-stat-label">GPU Count</span>
        <span class="infra-stat-value"><%= node.gpuCount %> x NVIDIA</span>
      </div>
      <div class="infra-stat">
        <span class="infra-stat-label">Node Age</span>
        <span class="infra-stat-value node-age" data-created="<%= node.creationTimestamp %>"></span>
      </div>
      <div class="infra-stat">
        <span class="infra-stat-label">Status</span>
        <span class="infra-stat-value" style="color: <%= node.ready ? '#22c55e' : '#ef4444' %>"><%= node.ready ? 'Ready' : 'NotReady' %></span>
      </div>
    </div>
    <% }); %>
  </div>
  <div style="margin-top: 0.75rem; font-size: 0.8rem; color: var(--pico-muted-color);">
    Total: <%= status.gpuNodes.totalNodes %> nodes, <%= status.gpuNodes.totalGpus %> GPUs
  </div>
</div>
<% } %>

<!-- LLM Namespace Section -->
<% if (status.llm) { %>
<div class="infra-section">
  <h3><span class="llm-icon">&#129302;</span> LLM Services</h3>
  <div class="infra-grid">
    <% status.llm.pods.forEach(pod => { %>
    <div class="infra-card <%= pod.ready ? 'healthy' : 'warning' %>">
      <div class="infra-card-header">
        <span class="infra-card-title">
          <%= pod.type === 'embeddings' ? 'TEI (Embeddings)' : pod.type === 'inference' ? 'vLLM (Inference)' : pod.name %>
        </span>
        <span class="infra-badge <%= pod.ready ? 'running' : '' %>"><%= pod.ready ? 'Running' : 'Not Ready' %></span>
      </div>
      <% if (pod.type === 'inference' || pod.type === 'embeddings') { %>
      <div class="gpu-dependency">Requires GPU Node</div>
      <% } %>
      <div class="infra-stat">
        <span class="infra-stat-label">Pod</span>
        <span class="infra-stat-value" style="font-size: 0.75rem;"><%= pod.name %></span>
      </div>
      <div class="infra-stat">
        <span class="infra-stat-label">Type</span>
        <span class="infra-stat-value"><%= pod.type %></span>
      </div>
    </div>
    <% }); %>
  </div>
  <div style="margin-top: 0.75rem; font-size: 0.8rem; color: var(--pico-muted-color);">
    Status: <%= status.llm.allRunning ? '✓ All Running' : '⚠ Some pods not running' %>
  </div>
</div>
<% } %>

<div class="last-updated">
  Last updated: <%= new Date(status.lastUpdated).toLocaleString() %>
</div>

<% } else { %>
<!-- No Data -->
<div class="empty-state">
  <div class="empty-state-icon">&#128230;</div>
  <p>No data available</p>
</div>
<% } %>

<script>
// Format node age from creation timestamp
function formatAge(timestamp) {
  const now = new Date()
  const created = new Date(timestamp)
  const diffMs = now - created
  const diffMins = Math.floor(diffMs / 60000)
  if (diffMins < 60) return `${diffMins}m`
  const diffHours = Math.floor(diffMins / 60)
  if (diffHours < 24) return `${diffHours}h ${diffMins % 60}m`
  const diffDays = Math.floor(diffHours / 24)
  return `${diffDays}d ${diffHours % 24}h`
}

// Initialize node age displays
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.node-age[data-created]').forEach(function(el) {
    const created = el.getAttribute('data-created')
    if (created) {
      el.textContent = formatAge(created)
    }
  })
})

async function refreshK8s() {
  const btn = document.querySelector('.refresh-btn');
  btn.disabled = true;
  btn.innerHTML = `
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" class="spin">
      <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
      <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
    </svg>
    Refreshing...
  `;
  try {
    window.location.href = '/k8s?refresh=1';
  } catch (error) {
    console.error('Failed to refresh:', error);
    btn.disabled = false;
    btn.innerHTML = `
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
        <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
      </svg>
      Refresh
    `;
  }
}
</script>

