<style>
  /* EKS Overview Page Styles */

  /* Cluster Card */
  .cluster-card {
    background: var(--pico-card-background-color);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: 0.75rem;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  .cluster-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), transparent);
    border-bottom: 1px solid var(--pico-muted-border-color);
  }

  .cluster-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cluster-icon {
    width: 32px;
    height: 32px;
    background: var(--pico-primary);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1rem;
  }

  .cluster-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--pico-h1-color);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    background: var(--pico-background-color);
  }

  .cluster-meta {
    display: flex;
    gap: 1.5rem;
    padding: 0.75rem 1.25rem;
    background: rgba(0, 0, 0, 0.1);
    font-size: 0.8rem;
    color: var(--pico-muted-color);
  }

  .cluster-meta-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .cluster-body {
    padding: 1.25rem;
  }

  .section-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--pico-h2-color);
    margin: 0 0 0.75rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .section-title .count {
    font-weight: 400;
    color: var(--pico-muted-color);
  }

  /* Nodegroup List */
  .nodegroup-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
    gap: 0.75rem;
  }

  .nodegroup-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: var(--pico-background-color);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nodegroup-item:hover {
    border-color: var(--pico-primary);
    background: rgba(139, 92, 246, 0.05);
  }

  .nodegroup-info {
    flex: 1;
    min-width: 0;
  }

  .nodegroup-name {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--pico-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nodegroup-meta {
    font-size: 0.7rem;
    color: var(--pico-muted-color);
    margin-top: 0.25rem;
  }

  .nodegroup-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nodegroup-state {
    font-size: 0.7rem;
    color: var(--pico-muted-color);
    text-transform: lowercase;
  }

  /* Instance List */
  .instance-list {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--pico-muted-border-color);
  }

  .instance-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    font-size: 0.7rem;
    color: var(--pico-muted-color);
  }

  .instance-id {
    font-family: monospace;
    color: var(--pico-color);
  }

  .kubelet-status {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.65rem;
    font-weight: 500;
  }

  .kubelet-joined {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  .kubelet-joining {
    background: rgba(234, 179, 8, 0.15);
    color: #eab308;
  }

  .kubelet-failed {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  .kubelet-unknown {
    background: rgba(107, 114, 128, 0.15);
    color: #6b7280;
  }

  .instance-summary {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-size: 0.65rem;
  }

  .instance-summary-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.375rem;
    background: var(--pico-background-color);
    border-radius: 0.25rem;
  }

  .systemlog-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    background: var(--pico-primary);
    color: white;
    border-radius: 0.25rem;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.15s ease;
  }

  .systemlog-btn:hover {
    opacity: 1;
  }

  /* Addon List */
  .addon-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--pico-muted-border-color);
  }

  .addon-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    background: var(--pico-background-color);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: 0.25rem;
    font-size: 0.75rem;
  }

  .addon-name {
    color: var(--pico-color);
  }

  .addon-version {
    color: var(--pico-muted-color);
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 3rem;
  }

  .empty-state-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .empty-state h3 {
    color: var(--pico-muted-color);
    margin-bottom: 0.5rem;
  }

  .empty-state p {
    color: var(--pico-muted-color);
    font-size: 0.875rem;
  }
</style>

<!-- Breadcrumb -->
<nav class="breadcrumb">
  <a href="/">Dashboard</a>
  <span>/</span>
  <span>EKS Overview</span>
</nav>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h2 class="page-title">EKS Clusters Overview</h2>
    <p class="page-subtitle">クラスタとNodegroupの全体状況</p>
  </div>
  <button class="refresh-btn" onclick="refreshEKS()">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
      <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
      <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
    </svg>
    Refresh
  </button>
</div>

<!-- Stats Bar -->
<div class="stats-bar">
  <div class="stat-item">
    <span class="stat-label">Clusters</span>
    <span class="stat-value highlight"><%= totalClusters %></span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Nodegroups</span>
    <span class="stat-value"><%= totalNodegroups %></span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Addons</span>
    <span class="stat-value"><%= totalAddons %></span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Auto Scaling Groups</span>
    <span class="stat-value"><%= totalASGs %></span>
  </div>
  <% if (lastUpdated) { %>
  <div class="stat-item">
    <span class="stat-label">Last Updated</span>
    <span class="stat-value" style="font-size: 0.875rem;"><%= lastUpdated %></span>
  </div>
  <% } %>
</div>

<% if (clusterInfos.length === 0) { %>
<!-- Empty State -->
<div class="empty-state">
  <div class="empty-state-icon">☸️</div>
  <h3>No EKS Clusters</h3>
  <p>現在、EKSクラスタは検出されていません</p>
</div>
<% } else { %>

<!-- Cluster Cards -->
<% clusterInfos.forEach(info => { %>
<div class="cluster-card">
  <div class="cluster-header">
    <div class="cluster-title">
      <div class="cluster-icon">☸️</div>
      <span class="cluster-name"><%= info.cluster.name %></span>
    </div>
    <div class="status-badge">
      <span class="status-dot <%= helpers.getStatusClass(info.cluster.state) %>"></span>
      <span><%= helpers.getStatusLabel(info.cluster.state) %></span>
    </div>
  </div>

  <div class="cluster-meta">
    <% if (info.cluster.metadata?.version) { %>
    <div class="cluster-meta-item">
      <span>Version:</span>
      <strong><%= info.cluster.metadata.version %></strong>
    </div>
    <% } %>
    <% if (info.cluster.metadata?.platformVersion) { %>
    <div class="cluster-meta-item">
      <span>Platform:</span>
      <strong><%= info.cluster.metadata.platformVersion %></strong>
    </div>
    <% } %>
    <div class="cluster-meta-item">
      <span>Nodegroups:</span>
      <strong><%= info.nodegroups.length %></strong>
    </div>
  </div>

  <div class="cluster-body">
    <% if (info.nodegroups.length > 0) { %>
    <h4 class="section-title">
      Nodegroups
      <span class="count">(<%= info.nodegroups.length %>)</span>
    </h4>
    <div class="nodegroup-list">
      <% info.nodegroups.forEach(ng => { %>
      <div class="nodegroup-item" style="flex-direction: column; align-items: stretch;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <span class="status-dot <%= helpers.getStatusClass(ng.state) %>"></span>
          <div class="nodegroup-info">
            <div class="nodegroup-name"><%= ng.name %></div>
            <div class="nodegroup-meta">
              <% if (ng.metadata?.instanceTypes) { %>
                <%= Array.isArray(ng.metadata.instanceTypes) ? ng.metadata.instanceTypes.join(', ') : ng.metadata.instanceTypes %>
              <% } %>
            </div>
          </div>
          <div class="nodegroup-actions">
            <span class="nodegroup-state"><%= ng.state %></span>
            <a href="/eks/nodegroups/<%= info.cluster.name %>/<%= ng.name %>/systemlog"
               class="systemlog-btn"
               title="View System Log">
              📋 Log
            </a>
          </div>
        </div>

        <!-- Auto Scaling Group Info -->
        <div style="margin-top: 0.5rem; padding: 0.5rem; background: rgba(139, 92, 246, 0.05); border-radius: 0.25rem; font-size: 0.75rem;">
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.25rem;">
              <span style="color: var(--pico-muted-color);">ASG:</span>
              <strong>Desired: <%= ng.metadata?.scalingConfig?.desiredSize ?? 0 %></strong>
              <span style="color: var(--pico-muted-color);">/</span>
              <span>Min: <%= ng.metadata?.scalingConfig?.minSize ?? 0 %></span>
              <span style="color: var(--pico-muted-color);">/</span>
              <span>Max: <%= ng.metadata?.scalingConfig?.maxSize ?? 0 %></span>
            </div>
            <% if (ng.instances && ng.instances.length > 0) { %>
            <div style="display: flex; align-items: center; gap: 0.25rem;">
              <span style="color: var(--pico-muted-color);">AZ:</span>
              <%
                const azCounts = {};
                ng.instances.forEach(i => {
                  const az = i.availabilityZone || 'unknown';
                  azCounts[az] = (azCounts[az] || 0) + 1;
                });
              %>
              <% Object.entries(azCounts).forEach(([az, count], idx) => { %>
                <% if (idx > 0) { %><span style="color: var(--pico-muted-color);">,</span><% } %>
                <span><%= az.split('-').pop() %>: <%= count %></span>
              <% }); %>
            </div>
            <% } %>
          </div>
        </div>
        <% if (ng.instances && ng.instances.length > 0) { %>
        <div class="instance-list">
          <div class="instance-summary">
            <%
              const runningCount = ng.instances.filter(i => i.state === 'running').length;
              const stoppedCount = ng.instances.filter(i => i.state === 'stopped').length;
              const otherStateCount = ng.instances.length - runningCount - stoppedCount;
              const joinedCount = ng.instances.filter(i => i.kubeletStatus === 'joined').length;
              const joiningCount = ng.instances.filter(i => i.kubeletStatus === 'joining').length;
              const failedCount = ng.instances.filter(i => i.kubeletStatus === 'failed').length;
              const unknownCount = ng.instances.filter(i => i.kubeletStatus === 'unknown').length;
            %>
            <!-- EC2 Instances -->
            <span class="instance-summary-item">
              EC2: <strong><%= ng.instances.length %></strong>
            </span>
            <% if (runningCount > 0) { %>
            <span class="instance-summary-item" style="background: rgba(34, 197, 94, 0.15); color: #22c55e;">
              running: <%= runningCount %>
            </span>
            <% } %>
            <% if (stoppedCount > 0) { %>
            <span class="instance-summary-item" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
              stopped: <%= stoppedCount %>
            </span>
            <% } %>
            <% if (otherStateCount > 0) { %>
            <span class="instance-summary-item" style="background: rgba(234, 179, 8, 0.15); color: #eab308;">
              other: <%= otherStateCount %>
            </span>
            <% } %>
          </div>
          <div class="instance-summary" style="margin-top: 0.25rem;">
            <!-- kubelet status -->
            <span class="instance-summary-item">
              kubelet:
            </span>
            <% if (joinedCount > 0) { %>
            <span class="instance-summary-item kubelet-joined">
              Ready: <%= joinedCount %>
            </span>
            <% } %>
            <% if (joiningCount > 0) { %>
            <span class="instance-summary-item kubelet-joining">
              Joining: <%= joiningCount %>
            </span>
            <% } %>
            <% if (failedCount > 0) { %>
            <span class="instance-summary-item kubelet-failed">
              NotReady: <%= failedCount %>
            </span>
            <% } %>
            <% if (unknownCount > 0) { %>
            <span class="instance-summary-item kubelet-unknown">
              Unknown: <%= unknownCount %>
            </span>
            <% } %>
          </div>
          <% ng.instances.forEach(instance => { %>
          <div class="instance-item">
            <span class="instance-id"><%= instance.instanceId %></span>
            <span class="kubelet-status kubelet-<%= instance.kubeletStatus || 'unknown' %>">
              <% if (instance.kubeletStatus === 'joined') { %>
                ✓ Joined
              <% } else if (instance.kubeletStatus === 'joining') { %>
                ⟳ Joining
              <% } else if (instance.kubeletStatus === 'failed') { %>
                ✗ Failed
              <% } else { %>
                ? Unknown
              <% } %>
            </span>
            <span><%= instance.state %></span>
            <% if (instance.privateIpAddress) { %>
            <span><%= instance.privateIpAddress %></span>
            <% } %>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="instance-list">
          <div class="instance-item" style="color: var(--pico-muted-color);">
            No instances found
          </div>
        </div>
        <% } %>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <p style="color: var(--pico-muted-color); font-size: 0.875rem;">No nodegroups attached to this cluster</p>
    <% } %>

    <% if (info.addons.length > 0) { %>
    <div class="addon-list">
      <span style="font-size: 0.75rem; color: var(--pico-muted-color); margin-right: 0.5rem;">Addons:</span>
      <% info.addons.forEach(addon => { %>
      <div class="addon-item">
        <span class="status-dot <%= helpers.getStatusClass(addon.state) %>" style="width: 6px; height: 6px;"></span>
        <span class="addon-name"><%= addon.name %></span>
        <% if (addon.metadata?.addonVersion) { %>
        <span class="addon-version">v<%= addon.metadata.addonVersion %></span>
        <% } %>
      </div>
      <% }); %>
    </div>
    <% } %>

    <% if (info.autoScalingGroups && info.autoScalingGroups.length > 0) { %>
    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--pico-muted-border-color);">
      <h4 class="section-title">
        Auto Scaling Groups
        <span class="count">(<%= info.autoScalingGroups.length %>)</span>
      </h4>
      <div class="nodegroup-list">
        <% info.autoScalingGroups.forEach(asg => { %>
        <div class="nodegroup-item">
          <span class="status-dot <%= helpers.getStatusClass(asg.state) %>"></span>
          <div class="nodegroup-info">
            <div class="nodegroup-name"><%= asg.name %></div>
            <div class="nodegroup-meta">
              <% if (asg.metadata?.desiredCapacity !== undefined) { %>
                Desired: <%= asg.metadata.desiredCapacity %>
              <% } %>
              <% if (asg.metadata?.minSize !== undefined && asg.metadata?.maxSize !== undefined) { %>
                • Min: <%= asg.metadata.minSize %> / Max: <%= asg.metadata.maxSize %>
              <% } %>
            </div>
          </div>
          <span class="nodegroup-state"><%= asg.state %></span>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
</div>
<% }); %>

<% } %>

<script>
async function refreshEKS() {
  const btn = document.querySelector('.refresh-btn');
  btn.disabled = true;
  btn.innerHTML = `
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" class="spin">
      <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
      <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
    </svg>
    Refreshing...
  `;
  try {
    await apiFetch('/aws/api/resources/refresh', { method: 'POST' });
    window.location.reload();
  } catch (error) {
    console.error('Failed to refresh:', error);
    btn.disabled = false;
    btn.innerHTML = `
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
        <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
      </svg>
      Refresh
    `;
  }
}
</script>
