<style>
  .cost-header-card {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(99, 102, 241, 0.1));
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .cost-header-label {
    font-size: 0.875rem;
    color: var(--pico-muted-color);
    margin-bottom: 0.25rem;
  }

  .cost-header-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--pico-h1-color);
  }

  .cost-header-meta {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--pico-muted-color);
  }

  .cost-header-meta span {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .cost-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--pico-card-background-color);
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--pico-muted-border-color);
  }

  .cost-table th {
    text-align: left;
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--pico-muted-color);
    background: var(--pico-background-color);
    border-bottom: 1px solid var(--pico-muted-border-color);
  }

  .cost-table td {
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    border-bottom: 1px solid var(--pico-muted-border-color);
  }

  .cost-table tr:last-child td {
    border-bottom: none;
  }

  .cost-table tr:hover td {
    background: rgba(139, 92, 246, 0.05);
  }

  .cost-service {
    font-weight: 500;
    color: var(--pico-color);
  }

  .cost-amount {
    font-weight: 600;
    color: var(--pico-h1-color);
    text-align: right;
  }

  .cost-bar-cell {
    width: 30%;
  }

  .cost-bar-container {
    height: 8px;
    background: var(--pico-background-color);
    border-radius: 4px;
    overflow: hidden;
  }

  .cost-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--pico-primary), #6366f1);
    border-radius: 4px;
    transition: width 0.3s ease;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--pico-muted-color);
  }

  .empty-state svg {
    width: 48px;
    height: 48px;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .refresh-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--pico-primary);
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    cursor: pointer;
    text-decoration: none;
  }

  .refresh-btn:hover {
    background: var(--pico-primary-hover);
  }
</style>

<!-- Breadcrumb -->
<nav class="breadcrumb">
  <a href="/">Dashboard</a>
  <span>/</span>
  <span>Costs</span>
</nav>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h2 class="page-title">Cost Explorer</h2>
    <p class="page-subtitle">AWS service costs sorted by amount (highest first)</p>
  </div>
  <a href="/costs" class="refresh-btn">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
      <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
      <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
    </svg>
    Refresh
  </a>
</div>

<% if (summary) { %>
<!-- Total Cost Header -->
<div class="cost-header-card">
  <div class="cost-header-label">Total Cost</div>
  <div class="cost-header-value">$<%= summary.totalAmount.toFixed(2) %> <%= summary.unit %></div>
  <div class="cost-header-meta">
    <span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm-3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm-5 3a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
      </svg>
      Period: <%= summary.periodStart %> ~ <%= summary.periodEnd %>
    </span>
    <span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5V2zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1H4z"/>
      </svg>
      <%= summary.serviceCount %> services
    </span>
  </div>
</div>
<% } %>

<% if (costs.length === 0) { %>
<div class="empty-state">
  <svg viewBox="0 0 16 16" fill="currentColor">
    <path d="M1 3a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V3zm2-1a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H3z"/>
  </svg>
  <p>No cost data available</p>
</div>
<% } else { %>
<%
  const maxAmount = Math.max(...costs.map(c => c.amount));
%>
<!-- Cost Table -->
<table class="cost-table">
  <thead>
    <tr>
      <th>Service</th>
      <th class="cost-bar-cell">Usage</th>
      <th style="text-align: right;">Amount</th>
    </tr>
  </thead>
  <tbody>
    <% costs.forEach(cost => { %>
      <% const percentage = maxAmount > 0 ? (cost.amount / maxAmount * 100) : 0; %>
      <tr>
        <td class="cost-service"><%= cost.service %></td>
        <td class="cost-bar-cell">
          <div class="cost-bar-container">
            <div class="cost-bar" style="width: <%= percentage %>%"></div>
          </div>
        </td>
        <td class="cost-amount">$<%= cost.amount.toFixed(2) %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<% } %>
