{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "doppler run -- npx tsx watch src/index.ts",
    "build": "tsc && cp -r src/presentation/views dist/presentation/views && mkdir -p dist/env && cp env/config.json dist/env/",
    "start": "doppler run -- node dist/index.js",
    "test": "dotenv -e .env.test -- npx vitest run",
    "test:watch": "dotenv -e .env.test -- npx vitest",
    "test:e2e": "doppler run -- npx playwright test",
    "test:e2e:ui": "doppler run -- npx playwright test --ui",
    "test:e2e:headed": "doppler run -- npx playwright test --headed"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.962.0",
    "@aws-sdk/client-auto-scaling": "^3.962.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.962.0",
    "@aws-sdk/client-cost-explorer": "^3.962.0",
    "@aws-sdk/client-ec2": "^3.962.0",
    "@aws-sdk/client-ecr": "^3.962.0",
    "@aws-sdk/client-eks": "^3.962.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.962.0",
    "@aws-sdk/client-elasticache": "^3.962.0",
    "@aws-sdk/client-firehose": "^3.962.0",
    "@aws-sdk/client-iam": "^3.962.0",
    "@aws-sdk/client-kms": "^3.962.0",
    "@aws-sdk/client-lambda": "^3.962.0",
    "@aws-sdk/client-rds": "^3.962.0",
    "@aws-sdk/client-route-53": "^3.962.0",
    "@aws-sdk/client-s3": "^3.962.0",
    "@aws-sdk/client-sqs": "^3.962.0",
    "@aws-sdk/client-ssm": "^3.962.0",
    "@hono/node-server": "^1.17.1",
    "@kubernetes/client-node": "^1.4.0",
    "awilix": "^12.0.5",
    "ejs": "^3.1.10",
    "hono": "^4.8.7",
    "hono-rate-limiter": "^0.5.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^13.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^20.11.17",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.15"
  }
}
