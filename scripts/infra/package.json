{
  "name": "infra-scripts",
  "version": "1.0.0",
  "description": "Infrastructure management scripts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "secrets": "tsx aws/secrets-manage.ts",
    "cognito": "tsx aws/cognito-manage.ts",
    "firehose": "tsx aws/firehose-manage.ts",
    "s3": "tsx aws/s3-manage.ts",
    "ecr": "tsx aws/ecr-manage.ts",
    "eks-deploy": "tsx eks-deploy.ts",
    "tf-deploy": "tsx tf-deploy.ts",
    "tf-destroy": "tsx tf-destroy.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pino": "^7.0.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "awilix": "^12.0.4",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.22.0"
  }
}
